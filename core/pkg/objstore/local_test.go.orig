package objstore

import (
	"bytes"
	"context"
	"io"
	"os"
	"path/filepath"
	"testing"
)

func TestLocalStore_PutGetList(t *testing.T) {
	dir := t.TempDir()
	store := NewLocalStore(dir)

	if store.Bucket() != dir {
		t.Fatalf("expected bucket %q, got %q", dir, store.Bucket())
	}

	ctx := context.Background()

	// Put an object.
	content := []byte(`{"evidence": "test-data"}`)
	if err := store.Put(ctx, "deploy-abc/2026-01-15/evidence/ctrl-1/ev1.json", bytes.NewReader(content), "application/json"); err != nil {
		t.Fatalf("Put failed: %v", err)
	}

	// Verify file exists on disk.
	diskPath := filepath.Join(dir, "deploy-abc/2026-01-15/evidence/ctrl-1/ev1.json")
	data, err := os.ReadFile(diskPath)
	if err != nil {
		t.Fatalf("file not found on disk: %v", err)
	}
	if !bytes.Equal(data, content) {
		t.Fatalf("content mismatch: got %q", string(data))
	}

	// Get the object back.
	rc, err := store.Get(ctx, "deploy-abc/2026-01-15/evidence/ctrl-1/ev1.json")
	if err != nil {
		t.Fatalf("Get failed: %v", err)
	}
	defer rc.Close()
	got, _ := io.ReadAll(rc)
	if !bytes.Equal(got, content) {
		t.Fatalf("Get content mismatch: got %q", string(got))
	}

	// Put a second object.
	content2 := []byte(`{"evidence": "second"}`)
	if err := store.Put(ctx, "deploy-abc/2026-01-15/evidence/ctrl-1/ev2.json", bytes.NewReader(content2), "application/json"); err != nil {
		t.Fatalf("Put second failed: %v", err)
	}

	// List with prefix.
	objects, err := store.List(ctx, "deploy-abc/2026-01-15/evidence/ctrl-1/")
	if err != nil {
		t.Fatalf("List failed: %v", err)
	}
	if len(objects) != 2 {
		t.Fatalf("expected 2 objects, got %d", len(objects))
	}

	// List with narrower prefix.
	objects, err = store.List(ctx, "deploy-abc/2026-01-15/evidence/ctrl-1/ev1")
	if err != nil {
		t.Fatalf("List narrow failed: %v", err)
	}
	if len(objects) != 1 {
		t.Fatalf("expected 1 object, got %d", len(objects))
	}
}

func TestLocalStore_GetNotFound(t *testing.T) {
	dir := t.TempDir()
	store := NewLocalStore(dir)

	_, err := store.Get(context.Background(), "nonexistent.json")
	if err == nil {
		t.Fatal("expected error for nonexistent file")
	}
}

func TestLocalStore_ListEmpty(t *testing.T) {
	dir := t.TempDir()
	store := NewLocalStore(dir)

	objects, err := store.List(context.Background(), "anything/")
	if err != nil {
		t.Fatalf("List failed: %v", err)
	}
	if len(objects) != 0 {
		t.Fatalf("expected 0 objects, got %d", len(objects))
	}
}

func TestLocalStore_PutCreatesDirectories(t *testing.T) {
	dir := t.TempDir()
	store := NewLocalStore(dir)

	err := store.Put(context.Background(), "deep/nested/path/file.json", bytes.NewReader([]byte("hi")), "text/plain")
	if err != nil {
		t.Fatalf("Put failed: %v", err)
	}

	data, err := os.ReadFile(filepath.Join(dir, "deep/nested/path/file.json"))
	if err != nil {
		t.Fatalf("file not created: %v", err)
	}
	if string(data) != "hi" {
		t.Fatalf("unexpected content: %q", string(data))
	}
}

func TestLocalStore_Errors(t *testing.T) {
	// Use a non-existent directory that cannot be created or accessed
	store := NewLocalStore("/root/protected/dir")
	ctx := context.Background()

	// Put error
	err := store.Put(ctx, "test.json", bytes.NewReader([]byte("test")), "application/json")
	if err == nil {
		t.Fatal("Put expected error, got nil")
	}

	// Get error
	_, err = store.Get(ctx, "test.json")
	if err == nil {
		t.Fatal("Get expected error, got nil")
	}

	// List error
	_, err = store.List(ctx, "")
	if err == nil {
		t.Fatal("List expected error, got nil")
	}
}
