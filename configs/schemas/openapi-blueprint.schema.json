{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAPIBlueprint",
  "type": "object",
  "properties": {
    "vendor_name": {
      "type": "string"
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "auth_flow": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["oauth2", "bearer"]
        },
        "token_url": {
          "type": "string"
        },
        "client_id_env": {
          "type": "string"
        },
        "client_secret_env": {
          "type": "string"
        },
        "token_env": {
          "type": "string"
        }
      },
      "required": ["type"]
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "erl_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "next_url_field": {
                "type": "string"
              },
              "max_pages": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["next_url_field"]
          },
          "allow_404": {
            "type": "boolean"
          }
        },
        "required": ["erl_id", "description"]
      }
    }
  },
  "required": ["vendor_name", "base_url", "auth_flow", "endpoints"]
}
