      "client_id_env": "AIK_CLIENT_ID",
      "client_secret_env": "AIK_SECRET_KEY"
    },
    "json_path": "$"
  },
  "E-TDA-11": {
    "description": "Aikido Code Repository SBOM",
    "provider": "aikido",
    "method": "GET",
    "url": "https://app.aikido.dev/api/public/v1/repositories/code/${AIK_CODE_REPO_ID}/licenses/export?format=sbom",
    "auth": {
      "type": "oauth2_client_credentials",
      "token_url": "https://app.aikido.dev/api/oauth/token",
      "client_id_env": "AIK_CLIENT_ID",
      "client_secret_env": "AIK_SECRET_KEY"
    },
    "json_path": "$"
  },
  "E-TDA-03": {
    "description": "Aikido Container SBOM",
    "provider": "aikido",
    "method": "GET",
    "url": "https://app.aikido.dev/api/public/v1/containers/${AIK_CONTAINER_ID}/licenses/export?format=sbom",
    "auth": {
      "type": "oauth2_client_credentials",
      "token_url": "https://app.aikido.dev/api/oauth/token",
      "client_id_env": "AIK_CLIENT_ID",
      "client_secret_env": "AIK_SECRET_KEY"
    },
    "json_path": "$"
  },
  "E-TDA-15": {
    "description": "Aikido Virtual Machine SBOM",
    "provider": "aikido",
    "method": "GET",
    "url": "https://app.aikido.dev/api/public/v1/virtual-machines/${AIK_VM_ID}/export/sbom",
    "auth": {
      "type": "oauth2_client_credentials",
      "token_url": "https://app.aikido.dev/api/oauth/token",
      "client_id_env": "AIK_CLIENT_ID",
      "client_secret_env": "AIK_SECRET_KEY"
    },
    "json_path": "$"
  },
  "E-CHG-01": {
    "description": "GitHub Repository Metadata",
    "provider": "github",
    "method": "GET",
    "url": "https://api.github.com/repos/${GITHUB_ORG}/${GITHUB_REPO}",
    "headers": {
      "Authorization": "Bearer ${GITHUB_TOKEN}",
      "Accept": "application/vnd.github.v3+json"
    },
    "json_path": "$"
  },
  "E-CHG-02": {
    "description": "GitHub Branch Protection Rules",
    "provider": "github",
    "method": "GET",
    "url": "https://api.github.com/repos/${GITHUB_ORG}/${GITHUB_REPO}/branches/main/protection",
    "headers": {
      "Authorization": "Bearer ${GITHUB_TOKEN}",
      "Accept": "application/vnd.github.v3+json"
    },
    "json_path": "$"
  },
  "E-CHG-03": {
    "description": "GitHub Recent Pull Requests",
    "provider": "github",
    "method": "GET",
    "url": "https://api.github.com/repos/${GITHUB_ORG}/${GITHUB_REPO}/pulls?state=all&per_page=100&sort=updated&direction=desc",
    "headers": {
      "Authorization": "Bearer ${GITHUB_TOKEN}",
      "Accept": "application/vnd.github.v3+json"
    },
    "json_path": "$"
  },
  "E-CHG-04": {
    "description": "GitHub CODEOWNERS File",
    "provider": "github",
    "method": "GET",
    "url": "https://api.github.com/repos/${GITHUB_ORG}/${GITHUB_REPO}/contents/CODEOWNERS",
    "headers": {
      "Authorization": "Bearer ${GITHUB_TOKEN}",
      "Accept": "application/vnd.github.v3+json"
    },
    "json_path": "$"
  },
  "E-VPM-02": {
    "description": "Aikido Vulnerability Scan Report",
    "provider": "aikido",
    "method": "GET",
    "url": "https://app.aikido.dev/api/public/v1/report/ciScans",
    "auth": {
      "type": "oauth2_client_credentials",
      "token_url": "https://app.aikido.dev/api/oauth/token",
      "client_id_env": "AIK_CLIENT_ID",
      "client_secret_env": "AIK_SECRET_KEY"
    },
    "json_path": "$"
  },
  "E-CHG-05": {
    "description": "GitHub Closed and Merged Pull Requests",
    "provider": "github",
    "method": "GET",
    "url": "https://api.github.com/repos/${GITHUB_ORG}/${GITHUB_REPO}/pulls?state=closed&per_page=100",
    "headers": {
      "Authorization": "Bearer ${GITHUB_TOKEN}",
      "Accept": "application/vnd.github.v3+json"
    },
    "json_path": "$"
  },
  "E-IAM-03": {
    "description": "GitHub Organization Administrators",
    "provider": "github",
    "method": "GET",
    "url": "https://api.github.com/orgs/${GITHUB_ORG}/members?role=admin&per_page=100",
    "headers": {
      "Authorization": "Bearer ${GITHUB_TOKEN}",
      "Accept": "application/vnd.github.v3+json"
    },
    "json_path": "$"
  }
}