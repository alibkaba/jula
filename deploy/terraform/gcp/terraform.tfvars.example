# ──────────────────────────────────────────────────────────────
# Jula Evidence Evaluator – User Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in your values.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Do NOT commit terraform.tfvars to version control because it
# may contain sensitive or environment-specific values.
# ──────────────────────────────────────────────────────────────

project_id           = "your-gcp-project-id"
region               = "us-central1"
docker_image         = "us-central1-docker.pkg.dev/your-gcp-project-id/jula-evidence-evaluator/jula:latest"
evidence_bucket_name = "jula-evidence-ledger"
owner_email          = "your-email@example.com"
github_org           = "your-github-org"

# Optional overrides (defaults shown):
# service_account_id     = "jula-eval-runner"
# signing_key_secret_id  = "jula-signing-key"
# github_token_secret_id = "jula-github-token"
# policy_repo_url        = "https://api.github.com/repos/alibkaba/jula-compliance-policies/tarball/main"
# scheduler_cron         = "30 3 * * *"
# scheduler_timezone     = "Etc/UTC"
